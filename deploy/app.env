# shellcheck shell=bash
# ════════════════════════════════════════════════════════════════════════════
#  app.env — ziptask service configuration
#
#  Vendored from synaptomind/deploy, which is itself vendored from
#  bun-templates/deploy.
#    upstream: https://forgejo.home.lan/authelia/bun-templates
#              commit 89be318daf8adab5ddca957162b3b7df8429e725
#    copied from: /mnt/external/zum/PROJECTS/remote/synaptomind @ 1a3a0d6
#              (dev) PLUS the uncommitted task #1108 framework gaps
#              (install.sh, update.sh, lib/common.sh, app.env.example)
#    sha256 at copy time:
#      install.sh       c5f9585474c2c496703446cd54e6c3e70901ae7ac081f428935d98a847a4b695
#      update.sh        123346a7e35e37ab1ad16f2e91a2bd0e3fc6de2bb31b7e96a4d7df892fa8183c
#      updater.sh       4fd6237459b06da48275698cacad20d788d5cd9ed3fc4fb0d9b0e6167cc4f387
#      uninstall.sh     8f2e712f7f815712c96c4d020cd743569ddbf1b04b4abe2505a075ec31da7ed2
#      lib/common.sh    2353658807f85daaffdf0b5835cf1da6ffecf8c33e09e981f6e36ec6d5bad27a
#      hooks/pre-update 6b1a6cdb1a9c4ab40b5ddb56acd978185b6acc68cd05257335bdf12587667ed8
#      hooks/post-update 3c930e1d6db6c3d4268d6bb2fa7c8c823abed64d312984796e7c761c315a08ab
#      app.env.example  55582656f59fc5a7b20edf4dab9782a48ef0464222c494f8035fbe5314b731fa
#
#  Local deviations from the vendored framework (see the epic #1105 ADR,
#  plans/2026-10-01-unify-deploy-framework-adr.md §4):
#    * install.sh  — DEPLOY_RAW_URL default + the one-liner in its header point at
#                    zumik3-del/ziptask instead of zumik3-del/synaptomind.
#    * updater.sh  — staging dir prefix is ${APP_NAME}-updater, not a literal.
#    * hooks/pre-update — resolve_db_paths reads ziptask's settings.json "dbPath"
#                    instead of synaptomind's config.json "path"/"logDbPath".
# ════════════════════════════════════════════════════════════════════════════

# ── Identity ───────────────────────────────────────────────────────────────
APP_NAME="ziptask"
APP_DESC="ziptask — MCP task tracker"

# ── Distribution ───────────────────────────────────────────────────────────
# "binary" installs the published release tarball: no bun, no node_modules, no
# git checkout on the host (ADR 0001-style self-contained payload).
DIST="binary"

# ── binary mode ────────────────────────────────────────────────────────────
# Asset URL = ${RELEASES_BASE}/${TAG}/${ASSET_PATTERN}
RELEASES_BASE="https://github.com/zumik3-del/ziptask/releases/download"
# The LIST endpoint, not /releases/latest: /latest silently excludes prereleases
# and cannot express CHECKOUT_POLICY. Unauthenticated = 60 requests/hour per IP,
# so a 403/429 surfaces as an explicit error naming the --version <tag> remedy.
RELEASE_API="https://api.github.com/repos/zumik3-del/ziptask/releases?per_page=30"
# SINGLE QUOTES ARE REQUIRED: load_app_env() sources this file, so double quotes
# would expand ${APP_NAME}/${TAG}/${OS}/${ARCH} here and leave render_template()
# nothing to substitute. Same for APP_VERSION_CMD, whose ${BIN} is set by
# app_version() at call time.
ASSET_PATTERN='${APP_NAME}-${TAG}-${OS}-${ARCH}.tar.gz'
# src/index.ts:25-27 prints "ziptask <version>"; app_version() strips the app
# name, so the gate compares the bare version against the tag.
APP_VERSION_CMD='${BIN} --version'

# ── binary mode: payload shape ─────────────────────────────────────────────
# The release tarball (see .github/workflows/release.yml, "Pack release
# tarball") holds exactly one top-level directory containing the single
# `ziptask` executable. These four lists are that shape, and the framework's
# defaults are synaptomind's, so ziptask names its own here.
BINARY_SUPPORTED_PLATFORMS="linux-x86_64"
BINARY_REQUIRED_FILES="ziptask"
BINARY_ROLLBACK_FILES="ziptask"
BINARY_SWAP_ORDER="ziptask"

# ── source mode (developer installs) ──────────────────────────────────────
# REPO_URL stays REQUIRED even in binary mode: the frozen updater.sh bootstrap
# shallow-clones the chosen tag to stage that release's own deploy/update.sh.
REPO_URL="https://github.com/zumik3-del/ziptask.git"
# stable | latest | prerelease select a release tag. A <branch> value is
# rejected in binary mode — a branch has no release asset.
CHECKOUT_POLICY="stable"

# ── Paths ──────────────────────────────────────────────────────────────────
# Canonical layout (ADR §1): code /opt/<app>, data /var/lib/<app>, state
# ~/.ziptask. RUN_DIR empty -> ${HOME}/.ziptask, which is where the helpers,
# hooks and app.env live — and where the service's settings.json is read from.
INSTALL_DIR="/opt/ziptask"
DATA_DIR="/var/lib/ziptask"
RUN_DIR=""

# ── First-run seeding ──────────────────────────────────────────────────────
# Copied only when the destination does NOT exist, so an installed host keeps
# its own settings.json. settings.example.json carries the live shape: host
# 127.0.0.1, port 3005, leaseTtlMin 45, the full defaults block, and an
# absolute dbPath into DATA_DIR (so resolution never depends on the ./data
# symlink being present).
SEED_FILES="settings.example.json:settings.json"
# ziptask has no secret to generate.
GENERATE_SECRET_IN=""

# ── Runtime / service ──────────────────────────────────────────────────────
SERVICE_USER="opencode"
# MUST be explicit: the binary-mode default (install.sh:default_exec_start) is
# ${INSTALL_DIR}/${APP_NAME} with no arguments, and ziptask reads its config
# only from --settings / ZIPTASK_SETTINGS (src/config.ts), so the default would
# silently run against ./data/ziptask.db under the unit's WorkingDirectory.
EXEC_START="/opt/ziptask/ziptask --settings /home/opencode/.ziptask/scripts/settings.json"
PORT="3005"
# src/server.ts:143 answers GET /health with {"ok":true}.
HEALTH_URL="http://127.0.0.1:3005/health"
HEALTH_TIMEOUT="60"
# A SECOND health window, used only when HEALTH_TIMEOUT expired with no answer
# at all. A timeout is this run's own bound, not a fact about the service, so an
# update that cannot confirm the new version is reported UNVERIFIED instead of
# failed-with-a-rollback. 0 disables the re-check — not recommended.
HEALTH_CONFIRM_TIMEOUT="30"

# ── Health contract (framework gap (d), ADR §3d) ───────────────────────────
# ziptask's /health carries neither a status string nor a version, so the
# framework's synaptomind-shaped defaults ("status" in ok|degraded, plus a
# "version") would declare a contract violation on a perfectly healthy service.
# With the version field empty the version check is disabled AND one explicit
# warning says so — the identity then rests on the status field alone, which is
# the most a {"ok":true} body can offer.
HEALTH_STATUS_FIELD="ok"
HEALTH_OK_VALUES="true"
HEALTH_VERSION_FIELD=""

# ── host requirements ──────────────────────────────────────────────────────
# "no" — a binary host needs no bun at install time or at runtime.
REQUIRES_BUN="no"
# "git tar" — tar extracts the release payload, git is only the updater.sh
# bootstrap. sqlite3 is required by the pre-update hook, which refuses to swap
# the payload without a WAL-safe .backup of the database first.
SYSTEM_DEP_CMDS="git tar sqlite3"
HOOKS_DIR=""
LIB_RAW_URL="https://raw.githubusercontent.com/zumik3-del/ziptask/main/deploy/lib/common.sh"