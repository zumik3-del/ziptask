{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "complexity": {
        "noUselessEmptyExport": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "formatter": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/mcp/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../db",
                      "../db/*",
                      "../db/**",
                      "../logger",
                      "../logger/*",
                      "../logger/**",
                      "bun:sqlite"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/core/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../mcp",
                      "../mcp/*",
                      "../mcp/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/db/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "../core/tasks": {
                    "allowImportNames": [
                      "Task",
                      "TaskStatus",
                      "TaskPriority",
                      "CommentType",
                      "clampLimit",
                      "monotonicNowMs",
                      "TERMINAL_STATUSES"
                    ]
                  },
                  "../core/types": {
                    "allowImportNames": [
                      "AuditStore",
                      "CommentRow",
                      "CommentStore",
                      "LeaseStore",
                      "ProjectListItem",
                      "ProjectRow",
                      "ProjectStore",
                      "Store",
                      "TaskStore"
                    ]
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "../mcp",
                      "../mcp/*",
                      "../mcp/**",
                      "../core",
                      "../core/*",
                      "../core/**",
                      "!../core/tasks",
                      "!../core/types"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}