{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "complexity": {
        "noUselessEmptyExport": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "always"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": ["src/mcp/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../db",
                      "../db/*",
                      "../db/**",
                      "../logger",
                      "../logger/*",
                      "../logger/**",
                      "bun:sqlite"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../db", "../db/*", "../db/**", "../mcp", "../mcp/*", "../mcp/**"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "../core/tasks": {
                    "allowImportNames": [
                      "asClock",
                      "clockNowIso",
                      "Task",
                      "TaskStatus",
                      "TaskPriority",
                      "CreatedTaskStatus",
                      "CommentType",
                      "clampLimit",
                      "clampCursor",
                      "Clock",
                      "nowIso",
                      "STATUS",
                      "TERMINAL_STATUSES",
                      "EDITABLE_STATUSES"
                    ]
                  },
                  "../core/types": {
                    "allowImportNames": [
                      "AuditStore",
                      "ChildStatusCounts",
                      "CommentRow",
                      "CommentStore",
                      "InsertTaskInput",
                      "LeaseStore",
                      "ListTasksFilters",
                      "ProjectListItem",
                      "ProjectRow",
                      "ProjectStore",
                      "Store",
                      "SvcResult",
                      "TaskStore",
                      "UpdateTaskPatch"
                    ]
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "../mcp",
                      "../mcp/*",
                      "../mcp/**",
                      "../core",
                      "../core/*",
                      "../core/**",
                      "!../core/tasks",
                      "!../core/types"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
