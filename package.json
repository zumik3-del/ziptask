{
  "name": "ziptask",
  "version": "0.6.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:stdio": "bun run src/index.ts --stdio",
    "dev": "bun --watch run src/index.ts",
    "build": "bun run tsc --noEmit",
    "build:bin": "bun run scripts/build.ts",
    "test": "bun test",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "format": "biome format --write src/ scripts/",
    "lint": "bunx biome check src/ scripts/"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
