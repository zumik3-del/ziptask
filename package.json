{
  "name": "ziptask",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:stdio": "bun run src/index.ts --stdio",
    "dev": "bun --watch run src/index.ts",
    "build": "bun run tsc --noEmit",
    "build:bin": "bun run scripts/build.ts",
    "test": "bun test",
    "lint": "bunx biome check src/",
    "release": "bash bin/release.sh",
    "changelog": "node bin/changelog.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
