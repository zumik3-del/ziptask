{
  "name": "ziptask",
  "version": "0.5.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {    "start": "bun run src/index.ts",
    "start:stdio": "bun run src/index.ts --stdio",
    "dev": "bun --watch run src/index.ts",
    "build": "bun run tsc --noEmit",
    "build:bin": "bun run scripts/build.ts",
    "test": "bun test",
    "lint": "bunx biome check src/ scripts/",
    "changelog": "bun run scripts/changelog.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
